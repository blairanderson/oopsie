<%= form_with(model: [ project, notification_rule ], class: "card form-card") do |f| %>
  <div class="form-group">
    <%= f.label :channel %>
    <%= f.select :channel, NotificationRule.channels.keys.map { |k| [k.titleize, k] },
        {}, class: "form-select" %>
    <% if notification_rule.errors[:channel].any? %>
      <div class="field-errors"><%= notification_rule.errors[:channel].join(", ") %></div>
    <% end %>
  </div>

  <div class="form-group">
    <%= f.label :destination, "Destination (email address or webhook URL)" %>
    <%= f.text_field :destination, placeholder: "alerts@example.com or https://hooks.slack.com/..." %>
    <% if notification_rule.errors[:destination].any? %>
      <div class="field-errors"><%= notification_rule.errors[:destination].join(", ") %></div>
    <% end %>
  </div>

  <div class="form-group">
    <%= f.label :webhook_header_name, "Webhook header (optional)" %>
    <%= f.text_field :webhook_header_name, placeholder: "Authorization" %>
    <small class="form-help">Use this for webhook services that require a custom header.</small>
  </div>

  <div class="form-group">
    <%= f.label :webhook_header_value, "Webhook header value (optional)" %>
    <%= f.text_field :webhook_header_value, placeholder: "Bearer your-token" %>
    <% if notification_rule.errors[:webhook_headers].any? %>
      <div class="field-errors"><%= notification_rule.errors[:webhook_headers].join(", ") %></div>
    <% end %>
  </div>

  <div style="display: flex; gap: 0.5rem;">
    <%= f.submit class: "btn btn-primary" %>
    <button type="submit"
        formaction="<%= test_send_project_notification_rules_path(project) %>"
        formmethod="post"
        formnovalidate
        class="btn btn-secondary"
        data-turbo="false">
      Send Test
    </button>
    <%= link_to "Cancel", settings_project_path(project), class: "btn btn-secondary" %>
  </div>
<% end %>
